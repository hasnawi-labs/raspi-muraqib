{
  "uid": "pi-logs",
  "title": "Raspberry Pi Logs",
  "tags": ["raspberry-pi"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container logs per second",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (rate({job=\"docker\"} |= \"$search\" [$__auto]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "System logs per second",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{unit}}",
          "expr": "topk(10, sum by (unit) (rate({job=\"journal\"} |= \"$search\" [$__auto])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors and warnings",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "errors",
          "expr": "sum(rate({job=~\"docker|journal\"} |= \"$search\" |~ \"(?i)(error|fatal|panic|warn)\" [$__auto]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Live logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "maxLines": 1000,
          "expr": "{job=~\"docker|journal\"} |= \"$search\""
        }
      ]
    }
  ]
}
